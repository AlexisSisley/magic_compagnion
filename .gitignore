# ===================================
# 1. RÈGLES D'ORIGINE (MAGIC COMPANION)
# ===================================

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
*.jks
*.keystore
keystore_base64.txt
key.properties
**/service-account.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
assets/json/*.json
!assets/json/data.zip

# Ancienne config backend
backend_rag/chroma_db/
backend_rag/venv

# ===================================
# 2. RÈGLES AJOUTÉES POUR RETRO-DOC
# ===================================

# Environnement virtuel Python (celui à la racine pour le script de doc)
venv/
.env

# Cache Python généré
__pycache__/

# Fichiers temporaires du pipeline de documentation
repomix-output.xml
architecture_doc_BRUT.yaml
debug_invalid.txt

.claude/worktrees/
.claude/*.json

# NOTE : On NE met PAS 'architecture_doc.yaml' ni 'ARCHITECTURE.md' ici
# car on veut qu'ils soient sauvegardés dans Git !